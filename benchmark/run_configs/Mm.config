workDir = "/scratch/users/jdoenier/dedup_benchmark/"

params {

        prefix = "Mm"
        results = "$SCRATCH/dedup_benchmark_results/${prefix}/"

        ont_reads = null
        illumina_reads = [
            ["$SCRATCH/dedup_benchmark/data/Mm/ERR3453868_1.fastq", "$SCRATCH/dedup_benchmark/data/Mm/ERR3453868_2.fastq"],
            ["$SCRATCH/dedup_benchmark/data/Mm/ERR3453869_1.fastq", "$SCRATCH/dedup_benchmark/data/Mm/ERR3453869_2.fastq"],
            ["$SCRATCH/dedup_benchmark/data/Mm/ERR3453870_1.fastq", "$SCRATCH/dedup_benchmark/data/Mm/ERR3453870_2.fastq"],
            ["$SCRATCH/dedup_benchmark/data/Mm/ERR3453871_1.fastq", "$SCRATCH/dedup_benchmark/data/Mm/ERR3453871_2.fastq"]
        ]
        pacbio_reads = [
            "$SCRATCH/dedup_benchmark/data/Mm/ERR3449634_subreads.fastq",
            "$SCRATCH/dedup_benchmark/data/Mm/ERR3453872_subreads.fastq",
            "$SCRATCH/dedup_benchmark/data/Mm/ERR3449630_subreads.fastq",
            "$SCRATCH/dedup_benchmark/data/Mm/ERR3449635_subreads.fastq",
            "$SCRATCH/dedup_benchmark/data/Mm/ERR3453874_subreads.fastq",
            "$SCRATCH/dedup_benchmark/data/Mm/ERR3453873_subreads.fastq",
            "$SCRATCH/dedup_benchmark/data/Mm/ERR3453876_subreads.fastq",
            "$SCRATCH/dedup_benchmark/data/Mm/ERR3453875_subreads.fastq"
        ]
        genome = "$SCRATCH/dedup_benchmark/data/Mm/fMyrMur1.PB.asm1.unzip.primary.fa"

        l = 40
        m = 100
        h = 160
} 