workDir = "/scratch/users/jdoenier/dedup_benchmark/"

params {

        prefix = "At"
        results = "$SCRATCH/dedup_benchmark_results/${prefix}/"

        ont_reads = null
        illumina_reads = [
            ["$SCRATCH/dedup_benchmark/data/At/SRR3703081_1.fastq", "$SCRATCH/dedup_benchmark/data/At/SRR3703081_2.fastq"],
            ["$SCRATCH/dedup_benchmark/data/At/SRR3703082_1.fastq", "$SCRATCH/dedup_benchmark/data/At/SRR3703082_2.fastq"],
            ["$SCRATCH/dedup_benchmark/data/At/SRR3703105_1.fastq", "$SCRATCH/dedup_benchmark/data/At/SRR3703105_2.fastq"]
        ]
        pacbio_reads = []
        genome = "$SCRATCH/dedup_benchmark/data/At/genome.fa"

        l = 40
        m = 100
        h = 160
} 